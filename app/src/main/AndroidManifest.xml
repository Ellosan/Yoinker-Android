<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Saving into Music/ and Movies/ needs this only before scoped storage. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".YoinkerApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Yoinker">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- The share-sheet entry. The filter carries its own label so the sheet
             reads "Yoink" while the app itself stays "Yoinker". -->
        <activity
            android:name=".share.ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.Yoinker.Sheet">
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- "Yoink" in the text-selection menu, for links inside a page. -->
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Runs one automation action and finishes. Started by the aliases below,
             by app shortcuts, or by another automation app's intent. -->
        <activity
            android:name=".automation.AutomationActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="com.pylo.yoinker.action.RUN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Modes & Routines (and any launcher-driven automation) can only "open an
             app", so each action is published as its own launchable entry. All are
             disabled until the user turns them on in Routines → Automation hooks,
             so they don't clutter the app drawer uninvited. -->
        <activity-alias
            android:name=".automation.alias.YoinkClipboard"
            android:targetActivity=".automation.AutomationActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/alias_yoink_clipboard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".automation.alias.StartQueue"
            android:targetActivity=".automation.AutomationActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/alias_start_queue">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".automation.alias.PauseQueue"
            android:targetActivity=".automation.AutomationActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/alias_pause_queue">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".automation.alias.ModeA"
            android:targetActivity=".automation.AutomationActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/alias_mode_a">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".automation.alias.ModeB"
            android:targetActivity=".automation.AutomationActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/alias_mode_b">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".automation.alias.ModeC"
            android:targetActivity=".automation.AutomationActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/alias_mode_c">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".download.YoinkService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".automation.AutomationService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Watches device state (Do Not Disturb, headphones, network, power) so the user's Yoinker routines can run while the app is in the background." />
        </service>

        <service
            android:name=".automation.YoinkTileService"
            android:exported="true"
            android:icon="@drawable/ic_yoink"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".automation.AutomationJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- The automation API other apps talk to: Tasker, MacroDroid, Automate,
             or anything that can fire a broadcast. -->
        <receiver
            android:name=".automation.AutomationReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.pylo.yoinker.action.YOINK" />
                <action android:name="com.pylo.yoinker.action.YOINK_CLIPBOARD" />
                <action android:name="com.pylo.yoinker.action.SET_MODE" />
                <action android:name="com.pylo.yoinker.action.START_QUEUE" />
                <action android:name="com.pylo.yoinker.action.PAUSE_QUEUE" />
                <action android:name="com.pylo.yoinker.action.RESUME_QUEUE" />
                <action android:name="com.pylo.yoinker.action.CLEAR_FINISHED" />
                <action android:name="com.pylo.yoinker.action.UPDATE_ENGINE" />
                <action android:name="com.pylo.yoinker.action.TRIGGER" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".automation.SystemEventsReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".automation.AlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".download.NotificationActionReceiver"
            android:exported="false" />

    </application>
</manifest>
